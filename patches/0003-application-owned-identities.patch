+    )
+
+    execute("""
+    CREATE SEQUENCE georelay_address_identity_seq AS bigint
+    INCREMENT BY -1 MINVALUE -9223372036854775807 MAXVALUE -1 START WITH -1 NO CYCLE
+    """)
+
+    create table(:georelay_identity_state, primary_key: false) do
+      add :singleton, :boolean, primary_key: true, default: true
+      add :version, :integer, null: false
+      add :kind, :string, null: false
+      add :evidence_sha256, :string
+      add :legacy_high_water, :bigint, null: false
+    end
