+++ b/elixir/lib/teslamate/locations/local_identities.ex
@@ -0,0 +1,431 @@
+defmodule TeslaMate.Locations.LocalIdentities do
+  @moduledoc """
+  Application-owned exact WGS84 identities. Initialization is explicit and never
+  inferred from an empty address table. Provider calls run outside DB transactions.
+  Legacy import is for a consistent, stopped/restored PostgreSQL + SQLite pair.
+  """
+
+  import Ecto.Query
+  alias TeslaMate.{Repo, Locations}
+  alias TeslaMate.Locations.{Address, Geocoder}
+
+  @max_id 9_223_372_036_854_775_807
+  @max_export_bytes 67_108_864
+  @index "addresses_georelay_coordinates_index"
+
+  def canonical(value, limit) do
+    decimal =
+      if is_struct(value, Decimal),
+        do: value,
+        else: Decimal.new(to_string(value), max_digits: 1024, max_exponent: 1024)
+
+    if is_integer(decimal.coef) and decimal.exp in -1024..1024 and
+         byte_size(Integer.to_string(decimal.coef)) <= 1024 and
+         Decimal.compare(%{decimal | sign: 1}, Decimal.new(limit)) != :gt do
+      text = Decimal.to_string(decimal, :normal, max_digits: 2048)
+
+      text =
+        if String.contains?(text, "."),
+          do: text |> String.trim_trailing("0") |> String.trim_trailing("."),
+          else: text
+
+      {:ok, if(decimal.coef == 0, do: "0", else: text)}
+    else
+      {:error, :invalid_coordinates}
+    end
+  rescue
+    _ -> {:error, :invalid_coordinates}
+  end
+
+  def context(raw) when is_map(raw) do
+    case Map.get(raw, "georelay") do
+      nil -> {:ok, %{"outside_mainland" => false}}
+      metadata -> validate_context(metadata)
+    end
+  end
+
+  def context(_), do: {:error, :invalid_provenance}
+
+  def validate_context(context) when is_map(context) do
+    source_type = context["source_osm_type"]
+    source_id = context["source_osm_id"]
+    outside = context["outside_mainland"]
+
+    source_valid =
+      (not Map.has_key?(context, "source_osm_type") and
+         not Map.has_key?(context, "source_osm_id")) or
+        (source_type in ["node", "way", "relation"] and is_integer(source_id) and
+           source_id > 0 and source_id <= @max_id)
+
+    if source_valid and is_boolean(outside) and (not outside or not is_nil(source_id)) do
+      {:ok, Map.take(context, ["source_osm_type", "source_osm_id", "outside_mainland"])}
+    else
+      {:error, :invalid_provenance}
+    end
+  end
+
+  def validate_context(_), do: {:error, :invalid_provenance}
+
+  def request_address(%Address{} = address) do
+    with true <-
+           address.osm_type == "node" and is_integer(address.osm_id) and
+             address.osm_id < 0 and address.osm_id >= -@max_id,
+         {:ok, lat} <- canonical(address.latitude, 90),
+         {:ok, lon} <- canonical(address.longitude, 180),
+         {:ok, context} <- context(address.raw) do
+      {:ok,
+       %{
+         "osm_id" => address.osm_id,
+         "osm_type" => "node",
+         "lat" => lat,
+         "lon" => lon,
+         "context" => context
+       }}
+    else
+      false -> {:error, :invalid_local_identity}
+      error -> error
+    end
+  end
+
+  def merge_raw(old, new) do
+    with {:ok, previous} <- context(old || %{}),
+         {:ok, current} <- context(new) do
+      metadata =
+        previous
+        |> Map.merge(current)
+        |> Map.put(
+          "outside_mainland",
+          previous["outside_mainland"] or current["outside_mainland"]
+        )
+        |> Map.put("version", 1)
+
+      # Missing optional fields in a non-OSM result must not erase proven sources.
+      Map.put(new, "georelay", metadata)
+    else
+      _ -> new
+    end
+  end
+
+  def ready? do
+    case Repo.query("SELECT version FROM georelay_identity_state WHERE singleton = true", [],
+           log: false
+         ) do
+      {:ok, %{rows: [[1]]}} -> true
+      _ -> false
+    end
+  rescue
+    _ -> false
+  end
+
+  def find_address(lat, lon, language) do
+    with true <- ready?(),
+         {:ok, lat} <- canonical(lat, 90),
+         {:ok, lon} <- canonical(lon, 180) do
+      case at_coordinates(lat, lon) do
+        %Address{} = address -> {:ok, address}
+        nil -> allocate_and_resolve(lat, lon, language)
+      end
+    else
+      false -> {:error, :identity_store_not_initialized}
+      error -> error
+    end
+  rescue
+    _ -> {:error, :identity_store_unavailable}
+  end
+
+  defp at_coordinates(lat, lon) do
+    # Query parameters go through Postgrex numeric encoding directly: Ecto's
+    # default decimal cast caps significant digits even for an exact NUMERIC.
+    values = Enum.map([lat, lon], &Decimal.new(&1, max_digits: 1024, max_exponent: 1024))
+
+    case Repo.query!(
+           "SELECT id FROM addresses WHERE osm_type = 'node' AND osm_id < 0 AND latitude = $1 AND longitude = $2",
+           values,
+           log: false
+         ).rows do
+      [] -> nil
+      [[id]] -> Repo.get!(Address, id, log: false)
+    end
+  end
+
+  defp allocate_and_resolve(lat, lon, language) do
+    case Repo.query("SELECT nextval('georelay_address_identity_seq')", [], log: false) do
+      {:ok, %{rows: [[id]]}} ->
+        request = %{
+          "osm_id" => id,
+          "osm_type" => "node",
+          "lat" => lat,
+          "lon" => lon,
+          "context" => %{"outside_mainland" => false}
+        }
+
+        with {:ok, attrs} <- Geocoder.reverse_local(request, language),
+             {:ok, _candidate} <-
+               %Address{}
+               |> Address.changeset(attrs)
+               |> Repo.insert(on_conflict: :nothing, log: false) do
+          # DO NOTHING covers the exact partial-coordinate index. Read the winning
+          # row after the conflicting insert completes; never return a losing ID.
+          case at_coordinates(lat, lon) do
+            %Address{} = winner -> {:ok, winner}
+            nil -> {:error, :identity_conflict}
+          end
+        else
+          {:error, reason} when is_atom(reason) -> {:error, reason}
+          _ -> {:error, :invalid_adapter_response}
+        end
+
+      _ ->
+        {:error, :identity_store_unavailable}
+    end
+  end
+
+  @doc "Default is a read-only preview. apply requires an explicit fresh-install assertion."
+  def initialize_fresh(opts \\ []) do
+    apply? = Keyword.get(opts, :apply, false)
+
+    if apply? and Keyword.get(opts, :fresh_install, false) != true do
+      {:error, :fresh_install_assertion_required}
+    else
+      transact(fn ->
+        if apply?, do: lock_initialization()
+
+        case state() do
+          nil ->
+            if Repo.exists?(from(a in Address, where: a.osm_id < 0), log: false),
+              do: Repo.rollback(:legacy_import_required)
+
+            if apply? do
+              create_index()
+              insert_state("fresh", nil, 0)
+              reserve_range(0)
+            end
+
+          %{kind: "fresh"} ->
+            :ok
+
+          _ ->
+            Repo.rollback(:already_initialized)
+        end
+
+        %{
+          mode: if(apply?, do: :applied, else: :preview),
+          kind: :fresh,
+          addresses: 0,
+          legacy_high_water: 0
+        }
+      end)
+    end
+  end
+
+  @doc "Audit an exported consistent legacy SQLite snapshot; write only with apply: true."
+  def import_file(path, opts \\ []) do
+    with {:ok, %{size: size, type: :regular}} when size <= @max_export_bytes <- File.stat(path),
+         {:ok, body} <- File.read(path),
+         {:ok, export} <- Jason.decode(body) do
+      digest = :crypto.hash(:sha256, body) |> Base.encode16(case: :lower)
+      import_export(export, digest, opts)
+    else
+      _ -> {:error, :invalid_legacy_export}
+    end
+  rescue
+    _ -> {:error, :invalid_legacy_export}
+  end
+
+  defp import_export(export, digest, opts) do
+    with {:ok, identities, high_water} <- validate_export(export) do
+      apply? = Keyword.get(opts, :apply, false)
+
+      transact(fn ->
+        if apply?, do: lock_initialization()
+
+        case state() do
+          nil ->
+            addresses = Repo.all(from(a in Address, where: a.osm_id < 0), log: false)
+            restored = audit_addresses(addresses, identities)
+
+            if apply? do
+              Enum.each(restored, fn {address, identity} ->
+                raw =
+                  Map.put(
+                    address.raw || %{},
+                    "georelay",
+                    Map.put(identity["context"], "version", 1)
+                  )
+
+                {:ok, _} =
+                  Locations.update_address(address, %{
+                    latitude: identity["lat"],
+                    longitude: identity["lon"],
+                    raw: raw
+                  })
+              end)
+
+              create_index()
+              insert_state("legacy", digest, high_water)
+              reserve_range(high_water)
+            end
+
+            %{
+              mode: if(apply?, do: :applied, else: :preview),
+              kind: :legacy,
+              addresses: length(restored),
+              legacy_high_water: high_water
+            }
+
+          %{kind: "legacy", evidence_sha256: ^digest, legacy_high_water: ^high_water} ->
+            %{
+              mode: :already_initialized,
+              kind: :legacy,
+              addresses:
+                Repo.aggregate(from(a in Address, where: a.osm_id < 0), :count, :id, log: false),
+              legacy_high_water: high_water
+            }
+
+          _ ->
+            Repo.rollback(:already_initialized)
+        end
+      end)
+    end
+  end
+
+  defp validate_export(%{
+         "format" => "georelay-legacy-identities-v1",
+         "allocated_high_water" => high_water,
+         "identities" => rows
+       })
+       when is_integer(high_water) and high_water >= 0 and high_water < @max_id and is_list(rows) do
+    rows
+    |> Enum.reduce_while({:ok, %{}, MapSet.new()}, fn row, {:ok, ids, points} ->
+      with %{
+             "osm_id" => id,
+             "osm_type" => "node",
+             "lat" => lat,
+             "lon" => lon,
+             "context" => context
+           }
+           when is_integer(id) and id < 0 and id >= -high_water <- row,
+           {:ok, canonical_lat} <- canonical(lat, 90),
+           {:ok, canonical_lon} <- canonical(lon, 180),
+           true <- lat == canonical_lat and lon == canonical_lon,
+           {:ok, _} <- validate_context(context),
+           false <- Map.has_key?(ids, id) or MapSet.member?(points, {lat, lon}) do
+        {:cont, {:ok, Map.put(ids, id, row), MapSet.put(points, {lat, lon})}}
+      else
+        _ -> {:halt, {:error, :invalid_legacy_export}}
+      end
+    end)
+    |> case do
+      {:ok, ids, _points} -> {:ok, ids, high_water}
+      error -> error
+    end
+  end
+
+  defp validate_export(_), do: {:error, :invalid_legacy_export}
+
+  defp audit_addresses(addresses, identities) do
+    {restored, _points} =
+      Enum.reduce(addresses, {[], MapSet.new()}, fn address, {restored, points} ->
+        identity = Map.get(identities, address.osm_id)
+        if address.osm_type != "node", do: Repo.rollback(:unsupported_legacy_identity)
+        if is_nil(identity), do: Repo.rollback(:missing_legacy_identity)
+
+        point = {identity["lat"], identity["lon"]}
+        if MapSet.member?(points, point), do: Repo.rollback(:legacy_coordinate_conflict)
+
+        for {field, key} <- [{:latitude, "lat"}, {:longitude, "lon"}] do
+          stored = Map.fetch!(address, field)
+          original = Decimal.new(identity[key], max_digits: 1024, max_exponent: 1024)
+          rounded = Decimal.round(original, 6, :half_up)
+
+          unless Decimal.equal?(stored, original) or Decimal.equal?(stored, rounded),
+            do: Repo.rollback(:legacy_coordinate_mismatch)
+
+          # Raw contains the old adapter's original WGS84 inputs, never supplier coordinates.
+          if is_map(address.raw) and Map.has_key?(address.raw, key) do
+            limit = if field == :latitude, do: 90, else: 180
+
+            unless canonical(address.raw[key], limit) == {:ok, identity[key]},
+              do: Repo.rollback(:legacy_raw_coordinate_mismatch)
+          end
+        end
+
+        if is_map(address.raw) do
+          case address.raw["upstream"] do
+            %{"osm_type" => type, "osm_id" => id} ->
+              unless identity["context"]["source_osm_type"] == type and
+                       identity["context"]["source_osm_id"] == id,
+                     do: Repo.rollback(:legacy_provenance_mismatch)
+
+            %{"provider" => provider} = upstream when provider in ["amap", "baidu"] ->
+              unless Map.keys(upstream) == ["provider"],
+                do: Repo.rollback(:legacy_provenance_mismatch)
+
+            nil ->
+              :ok
+
+            _ ->
+              Repo.rollback(:legacy_provenance_mismatch)
+          end
+        end
+
+        {[{address, identity} | restored], MapSet.put(points, point)}
+      end)
+
+    restored
+  end
+
+  defp lock_initialization do
+    Repo.query!("SELECT pg_advisory_xact_lock(714309031)", [], log: false)
+    Repo.query!("LOCK TABLE addresses IN SHARE ROW EXCLUSIVE MODE", [], log: false)
+  end
+
+  defp state do
+    case Repo.query!(
+           "SELECT kind, evidence_sha256, legacy_high_water FROM georelay_identity_state WHERE singleton = true",
+           [],
+           log: false
+         ).rows do
+      [] ->
+        nil
+
+      [[kind, digest, high_water]] ->
+        %{kind: kind, evidence_sha256: digest, legacy_high_water: high_water}
+    end
+  end
+
+  defp insert_state(kind, digest, high_water) do
+    Repo.query!(
+      "INSERT INTO georelay_identity_state(singleton,version,kind,evidence_sha256,legacy_high_water) VALUES(true,1,$1,$2,$3)",
+      [kind, digest, high_water],
+      log: false
+    )
+  end
+
+  defp create_index do
+    Repo.query!(
+      "CREATE UNIQUE INDEX #{@index} ON addresses(latitude,longitude) WHERE osm_type = 'node' AND osm_id < 0",
+      [],
+      log: false
+    )
+  end
+
+  defp reserve_range(high_water) do
+    # Sequence values are nontransactional. Never move an existing high water back.
+    [[last, called]] =
+      Repo.query!("SELECT last_value, is_called FROM georelay_address_identity_seq", [],
+        log: false
+      ).rows
+
+    next = if called, do: last - 1, else: last
+    target = min(next, -high_water - 1)
+    if target < -@max_id, do: Repo.rollback(:identity_range_exhausted)
+    Repo.query!("SELECT setval('georelay_address_identity_seq', $1, false)", [target], log: false)
+  end
+
+  defp transact(fun) do
+    Repo.transaction(fun, log: false)
+  rescue
+    _ -> {:error, :identity_store_unavailable}
+  end
+end
