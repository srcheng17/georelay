@@ -0,0 +1,662 @@
+defmodule TeslaMate.Locations.LocalIdentitiesTest do
+  use TeslaMate.DataCase, async: false
+
+  alias TeslaMate.{HTTP, Locations, Log}
+  alias TeslaMate.Locations.{Address, Geocoder, LocalIdentities}
+  alias TeslaMate.Log.{ChargingProcess, Drive}
+  import Mock
+  import ExUnit.CaptureLog
+
+  setup do
+    for {key, value} <- [
+          {"GEORELAY_ADDRESS_MODE", "application"},
+          {"NOMINATIM_BASE_URL", "http://adapter:8080"}
+        ] do
+      previous = System.get_env(key)
+      System.put_env(key, value)
+
+      on_exit(fn ->
+        if previous, do: System.put_env(key, previous), else: System.delete_env(key)
+      end)
+    end
+
+    :ok
+  end
+
+  test "mode is explicit and startup rejects invalid settings without disclosing them" do
+    System.delete_env("GEORELAY_ADDRESS_MODE")
+    refute HTTP.application_address_identities?()
+    System.put_env("GEORELAY_ADDRESS_MODE", "application")
+    assert HTTP.application_address_identities?()
+    System.put_env("GEORELAY_ADDRESS_MODE", "private-invalid-value")
+
+    assert_raise ArgumentError, "GEORELAY_ADDRESS_MODE must be nominatim or application", fn ->
+      HTTP.child_spec(nil)
+    end
+  end
+
+  test "fresh preview is read-only and apply requires a separate explicit assertion" do
+    assert {:ok, %{mode: :preview, addresses: 0}} = LocalIdentities.initialize_fresh()
+    refute LocalIdentities.ready?()
+
+    assert {:error, :fresh_install_assertion_required} =
+             LocalIdentities.initialize_fresh(apply: true)
+
+    assert {:error, :identity_store_not_initialized} = Locations.find_address(point())
+    assert {:error, :identity_store_not_initialized} = Geocoder.details([], "en")
+    assert Repo.aggregate(Address, :count) == 0
+    initialize()
+    assert LocalIdentities.ready?()
+    assert {:ok, _} = LocalIdentities.initialize_fresh(apply: true, fresh_install: true)
+    assert {:error, :local_identity_required} = Geocoder.reverse_lookup("1", "2")
+  end
+
+  test "fresh initialization refuses historical negative IDs" do
+    historical(-42)
+    assert {:error, :legacy_import_required} = LocalIdentities.initialize_fresh()
+
+    assert {:error, :legacy_import_required} =
+             LocalIdentities.initialize_fresh(apply: true, fresh_install: true)
+
+    refute LocalIdentities.ready?()
+  end
+
+  test "normalization preserves long exact values, bounds and numerical equivalence" do
+    assert {:ok, "48.858400123"} = LocalIdentities.canonical("4.8858400123e1", 90)
+    assert {:ok, "0"} = LocalIdentities.canonical("-0.000", 90)
+
+    assert {:ok, "1.123456789012345678901234567890123"} =
+             LocalIdentities.canonical("1.123456789012345678901234567890123000", 90)
+
+    for value <- ["NaN", "Infinity", "-91", "91", nil, "secret-invalid"] do
+      assert {:error, :invalid_coordinates} = LocalIdentities.canonical(value, 90)
+    end
+  end
+
+  test "precise identities are PG-owned and reused before any network call" do
+    initialize()
+
+    with_mock Tesla.Adapter.Finch,
+      call: fn env, _ ->
+        assert env.method == :post
+        assert env.url == "http://adapter:8080/v1/reverse"
+        body = Jason.decode!(env.body)
+        assert body["version"] == 1
+        assert is_binary(body["language"])
+        {:ok, %{env | status: 200, body: response(body["address"])}}
+      end do
+      assert {:ok, first} = Locations.find_address(point())
+      assert first.osm_id < 0
+      assert Decimal.equal?(first.latitude, "48.858400123")
+      assert Decimal.equal?(first.longitude, "2.294500456")
+
+      assert {:ok, again} =
+               Locations.find_address(%{
+                 latitude: Decimal.new("48.8584001230"),
+                 longitude: Decimal.new("2.2945004560")
+               })
+
+      assert again.id == first.id
+      assert called(Tesla.Adapter.Finch.call(:_, :_))
+
+      assert {:ok, distinct} =
+               Locations.find_address(%{latitude: "48.858400124", longitude: "2.294500457"})
+
+      assert distinct.id != first.id
+    end
+
+    assert Repo.aggregate(Address, :count) == 2
+  end
+
+  test "concurrent first requests insert one winner after all candidates have resolved" do
+    initialize()
+    owner = self()
+
+    with_mock Tesla.Adapter.Finch,
+      call: fn env, _ ->
+        request = Jason.decode!(env.body)["address"]
+        send(owner, {:candidate, self(), request["osm_id"]})
+
+        receive do
+          :provider_success -> {:ok, %{env | status: 200, body: response(request)}}
+        after
+          5000 -> raise "synthetic provider barrier expired"
+        end
+      end do
+      tasks = for _ <- 1..8, do: Task.async(fn -> Locations.find_address(point()) end)
+
+      candidates =
+        for _ <- 1..8 do
+          assert_receive {:candidate, pid, id}, 5000
+          {pid, id}
+        end
+
+      assert length(Enum.uniq_by(candidates, &elem(&1, 1))) == 8
+      Enum.each(candidates, fn {pid, _} -> send(pid, :provider_success) end)
+
+      addresses =
+        Enum.map(tasks, fn task ->
+          assert {:ok, address} = Task.await(task, 5000)
+          address
+        end)
+
+      assert length(Enum.uniq_by(addresses, & &1.id)) == 1
+      assert length(Enum.uniq_by(addresses, & &1.osm_id)) == 1
+      assert Repo.aggregate(Address, :count) == 1
+      assert Enum.all?(addresses, &(&1.raw["osm_id"] == &1.osm_id))
+    end
+  end
+
+  test "a losing candidate resolves to the stored identity and raw uses the winner" do
+    initialize()
+
+    with_mock Tesla.Adapter.Finch,
+      call: fn env, _ ->
+        request = Jason.decode!(env.body)["address"]
+        winner_request = Map.put(request, "osm_id", request["osm_id"] - 100_000)
+        winner_raw = response(winner_request)
+
+        {:ok, _} =
+          Locations.create_address(%{
+            osm_id: winner_request["osm_id"],
+            osm_type: "node",
+            latitude: request["lat"],
+            longitude: request["lon"],
+            display_name: "Winning address",
+            raw: winner_raw
+          })
+
+        {:ok, %{env | status: 200, body: response(request)}}
+      end do
+      assert {:ok, winner} = Locations.find_address(point())
+      assert winner.display_name == "Winning address"
+      assert winner.raw["osm_id"] == winner.osm_id
+    end
+
+    assert Repo.aggregate(Address, :count) == 1
+  end
+
+  test "provider and malformed-success failures do not persist Unknown or partial addresses" do
+    initialize()
+
+    with_mock Tesla.Adapter.Finch,
+      call: fn env, _ ->
+        {:ok, %{env | status: 502, body: %{"error" => "private upstream text"}}}
+      end do
+      log =
+        capture_log(fn ->
+          assert {:error, :geocoder_unavailable} = Locations.find_address(point())
+        end)
+
+      refute log =~ "private upstream text"
+    end
+
+    for mutate <- [
+          &Map.put(&1, "error", "Unable to geocode"),
+          &Map.put(&1, "osm_id", 42),
+          &Map.put(&1, "osm_type", "way"),
+          &Map.put(&1, "lat", "48.8584"),
+          &Map.put(&1, "display_name", ""),
+          &Map.delete(&1, "georelay"),
+          &Map.put(&1, "georelay", %{"version" => 2, "outside_mainland" => false}),
+          &Map.put(&1, "georelay", %{
+            "version" => 1,
+            "source_osm_id" => -1,
+            "source_osm_type" => "way",
+            "outside_mainland" => false
+          })
+        ] do
+      with_mock Tesla.Adapter.Finch,
+        call: fn env, _ ->
+          raw = Jason.decode!(env.body)["address"] |> response() |> mutate.()
+          {:ok, %{env | status: 200, body: raw}}
+        end do
+        assert {:error, :invalid_adapter_response} = Locations.find_address(point())
+      end
+
+      assert Repo.aggregate(Address, :count) == 0
+    end
+  end
+
+  test "lookup includes original coordinates and permanent provenance; source survives switching" do
+    initialize()
+
+    request = %{
+      "osm_id" => -42,
+      "osm_type" => "node",
+      "lat" => "48.858400123",
+      "lon" => "2.294500456",
+      "context" => source_context()
+    }
+
+    raw = response(request)
+
+    {:ok, local} =
+      Locations.create_address(%{
+        osm_id: -42,
+        osm_type: "node",
+        latitude: request["lat"],
+        longitude: request["lon"],
+        display_name: "Original",
+        raw: raw
+      })
+
+    old = historical(42, "way")
+
+    with_mocks [
+      {GeocoderMock, [], details: &Geocoder.details/2},
+      {Tesla.Adapter.Finch, [],
+       call: fn env, _ ->
+         assert env.method == :post
+         assert env.url == "http://adapter:8080/v1/lookup"
+         body = Jason.decode!(env.body)
+         assert body["language"] == "zh-CN"
+         assert body["addresses"] == [request]
+         refreshed = response(request) |> Map.put("display_name", "Refreshed")
+         # A non-OSM response cannot erase earlier OSM/region evidence.
+         refreshed =
+           Map.put(refreshed, "georelay", %{"version" => 1, "outside_mainland" => false})
+
+         {:ok, %{env | status: 200, body: Jason.encode!([refreshed])}}
+       end}
+    ] do
+      assert Locations.refresh_addresses("zh-CN") == :ok
+    end
+
+    stored = Repo.get!(Address, local.id)
+    assert stored.raw["georelay"] == Map.put(source_context(), "version", 1)
+    assert stored.display_name == "Refreshed"
+    assert stored.latitude == local.latitude
+    assert Repo.get!(Address, old.id) == old
+    assert {:ok, []} = Geocoder.details([old], "en")
+  end
+
+  test "an existing trusted source must match even a structurally valid response source" do
+    initialize()
+    request = identity(-42, "48.858400123", "2.294500456", source_context())
+
+    {:ok, local} =
+      Locations.create_address(%{
+        osm_id: -42,
+        osm_type: "node",
+        latitude: request["lat"],
+        longitude: request["lon"],
+        display_name: "Trusted original",
+        raw: response(request)
+      })
+
+    for context <- [
+          Map.put(source_context(), "source_osm_id", 43),
+          Map.put(source_context(), "source_osm_type", "relation")
+        ] do
+      with_mocks [
+        {GeocoderMock, [], details: &Geocoder.details/2},
+        {Tesla.Adapter.Finch, [],
+         call: fn env, _ ->
+           raw = request |> response() |> Map.put("display_name", "Mismatched source")
+           raw = Map.put(raw, "georelay", Map.put(context, "version", 1))
+           {:ok, %{env | status: 200, body: Jason.encode!([raw])}}
+         end}
+      ] do
+        capture_log(fn ->
+          assert {:error, :invalid_adapter_response} = Locations.refresh_addresses("en")
+        end)
+      end
+
+      assert Repo.get!(Address, local.id) == local
+    end
+  end
+
+  test "a newly allocated address can retain newly validated source provenance" do
+    initialize()
+
+    with_mock Tesla.Adapter.Finch,
+      call: fn env, _ ->
+        raw = Jason.decode!(env.body)["address"] |> response()
+        raw = Map.put(raw, "georelay", Map.put(source_context(), "version", 1))
+        {:ok, %{env | status: 200, body: raw}}
+      end do
+      assert {:ok, address} = Locations.find_address(point())
+      assert address.raw["georelay"] == Map.put(source_context(), "version", 1)
+    end
+  end
+
+  test "present-null provenance is rejected without clearing an existing source" do
+    initialize()
+    request = identity(-42, "48.858400123", "2.294500456", source_context())
+
+    {:ok, local} =
+      Locations.create_address(%{
+        osm_id: -42,
+        osm_type: "node",
+        latitude: request["lat"],
+        longitude: request["lon"],
+        display_name: "Trusted original",
+        raw: response(request)
+      })
+
+    for context <- [
+          %{"outside_mainland" => false, "source_osm_type" => nil, "source_osm_id" => nil},
+          %{"outside_mainland" => false, "source_osm_type" => nil},
+          %{"outside_mainland" => false, "source_osm_id" => nil},
+          %{"outside_mainland" => false, "source_osm_type" => "way", "source_osm_id" => nil},
+          %{"outside_mainland" => false, "source_osm_type" => nil, "source_osm_id" => 42}
+        ] do
+      with_mocks [
+        {GeocoderMock, [], details: &Geocoder.details/2},
+        {Tesla.Adapter.Finch, [],
+         call: fn env, _ ->
+           raw = request |> response() |> Map.put("display_name", "Untrusted replacement")
+           raw = Map.put(raw, "georelay", Map.put(context, "version", 1))
+           {:ok, %{env | status: 200, body: Jason.encode!([raw])}}
+         end}
+      ] do
+        capture_log(fn ->
+          assert {:error, :invalid_adapter_response} = Locations.refresh_addresses("en")
+        end)
+      end
+
+      assert Repo.get!(Address, local.id) == local
+
+      assert Repo.get!(Address, local.id).raw["georelay"] ==
+               Map.put(source_context(), "version", 1)
+
+      assert {:error, :invalid_provenance} = LocalIdentities.validate_context(context)
+    end
+
+    assert {:ok, %{"outside_mainland" => false}} =
+             LocalIdentities.validate_context(%{"outside_mainland" => false})
+  end
+
+  test "legacy present-null sources are rejected before restoring coordinates or marking ready" do
+    local = historical(-42)
+
+    for context <- [
+          %{"outside_mainland" => false, "source_osm_type" => nil, "source_osm_id" => nil},
+          %{"outside_mainland" => false, "source_osm_type" => nil},
+          %{"outside_mainland" => false, "source_osm_id" => nil}
+        ] do
+      path = export_file([identity(-42, "48.858400123", "2.294500456", context)], 100)
+      assert {:error, :invalid_legacy_export} = LocalIdentities.import_file(path, apply: true)
+      assert Repo.get!(Address, local.id) == local
+      refute LocalIdentities.ready?()
+    end
+  end
+
+  test "lookup rejects missing duplicate extra or mismatching items before any update" do
+    initialize()
+    a = historical(-42, "node", "48.858400123", "2.294500456")
+    b = historical(-43, "node", "48.858400124", "2.294500457")
+
+    for kind <- [:missing, :duplicate, :extra, :coordinates] do
+      with_mocks [
+        {GeocoderMock, [], details: &Geocoder.details/2},
+        {Tesla.Adapter.Finch, [],
+         call: fn env, _ ->
+           requests = Jason.decode!(env.body)["addresses"]
+           raws = Enum.map(requests, &response/1)
+
+           result =
+             case kind do
+               :missing -> Enum.take(raws, 1)
+               :duplicate -> [hd(raws), hd(raws)]
+               :extra -> raws ++ [Map.put(hd(raws), "osm_id", -999)]
+               :coordinates -> [Map.put(hd(raws), "lon", "0"), List.last(raws)]
+             end
+
+           {:ok, %{env | status: 200, body: Jason.encode!(result)}}
+         end}
+      ] do
+        log =
+          capture_log(fn ->
+            assert {:error, :invalid_adapter_response} = Locations.refresh_addresses("en")
+          end)
+
+        refute log =~ "48.858400123"
+        refute log =~ "Synthetic address"
+      end
+
+      assert Repo.get!(Address, a.id) == a
+      assert Repo.get!(Address, b.id) == b
+    end
+  end
+
+  test "legacy audit restores exact precision without changing identities or event references" do
+    a = historical(-42, "node", "48.858400", "2.294500")
+    b = historical(-43, "node", "48.858400", "2.294500")
+    {:ok, car} = Log.create_car(%{eid: 42, vid: 42, vin: "import-synthetic"})
+    date = ~U[2024-01-01 00:00:00.000000Z]
+
+    {:ok, position} =
+      Log.insert_position(car, %{date: date, latitude: "48.8584", longitude: "2.2945"})
+
+    drive =
+      Repo.insert!(%Drive{
+        car_id: car.id,
+        start_date: date,
+        start_address_id: a.id,
+        end_address_id: b.id
+      })
+
+    charging =
+      Repo.insert!(%ChargingProcess{
+        car_id: car.id,
+        start_date: date,
+        position_id: position.id,
+        address_id: a.id
+      })
+
+    path =
+      export_file(
+        [
+          identity(-42, "48.858400123", "2.294500456", source_context()),
+          identity(-43, "48.858400124", "2.294500457")
+        ],
+        10_000
+      )
+
+    assert {:ok, %{mode: :preview, addresses: 2, legacy_high_water: 10_000}} =
+             LocalIdentities.import_file(path)
+
+    assert Repo.get!(Address, a.id) == a
+    refute LocalIdentities.ready?()
+    assert {:ok, %{mode: :applied}} = LocalIdentities.import_file(path, apply: true)
+    assert {:ok, %{mode: :already_initialized}} = LocalIdentities.import_file(path, apply: true)
+    restored = Repo.get!(Address, a.id)
+    assert restored.osm_id == -42
+    assert Decimal.equal?(restored.latitude, "48.858400123")
+    assert Decimal.equal?(Repo.get!(Address, b.id).latitude, "48.858400124")
+    assert restored.raw["georelay"] == Map.put(source_context(), "version", 1)
+    assert Repo.get!(Drive, drive.id).start_address_id == a.id
+    assert Repo.get!(Drive, drive.id).end_address_id == b.id
+    assert Repo.get!(ChargingProcess, charging.id).address_id == a.id
+    assert Repo.get!(TeslaMate.Log.Position, position.id) == position
+    [[next]] = Repo.query!("SELECT nextval('georelay_address_identity_seq')", [], log: false).rows
+    assert next < -10_000
+    assert Repo.aggregate(Address, :count) == 2
+    # A later six-place Position is a different exact point, never rounded into A.
+    with_mock Tesla.Adapter.Finch,
+      call: fn env, _ ->
+        {:ok, %{env | status: 200, body: response(Jason.decode!(env.body)["address"])}}
+      end do
+      assert {:ok, separate} =
+               Locations.find_address(%{
+                 latitude: position.latitude,
+                 longitude: position.longitude
+               })
+
+      assert separate.id not in [a.id, b.id]
+    end
+  end
+
+  test "legacy missing conflicting provenance and invalid evidence fail before any write" do
+    a = historical(-42)
+
+    for {rows, high_water, reason} <- [
+          {[], 100, :missing_legacy_identity},
+          {[identity(-42, "49", "2")], 100, :legacy_coordinate_mismatch},
+          {[identity(-42), identity(-42)], 100, :invalid_legacy_export},
+          {[identity(-42)], 10, :invalid_legacy_export},
+          {[identity(-42)], 9_223_372_036_854_775_807, :invalid_legacy_export},
+          {[identity(-42, "48.8584", "2.2945", %{"outside_mainland" => true})], 100,
+           :invalid_legacy_export}
+        ] do
+      path = export_file(rows, high_water)
+      assert {:error, ^reason} = LocalIdentities.import_file(path, apply: true)
+      assert Repo.get!(Address, a.id) == a
+      refute LocalIdentities.ready?()
+    end
+
+    {:ok, a} =
+      Locations.update_address(a, %{
+        raw: %{"upstream" => %{"provider" => "osm", "osm_type" => "way", "osm_id" => 99}}
+      })
+
+    path = export_file([identity(-42, "48.8584", "2.2945", source_context())], 100)
+    assert {:error, :legacy_provenance_mismatch} = LocalIdentities.import_file(path, apply: true)
+    assert Repo.get!(Address, a.id) == a
+  end
+
+  test "failure after a validated import update rolls back all address changes and marker" do
+    a = historical(-42)
+    path = export_file([identity(-42, "48.858400123", "2.294500456")], 100)
+    # Existing index with this reserved name makes the final DDL fail.
+    Repo.query!("CREATE INDEX addresses_georelay_coordinates_index ON addresses(id)")
+    assert {:error, :identity_store_unavailable} = LocalIdentities.import_file(path, apply: true)
+    assert Repo.get!(Address, a.id) == a
+    refute LocalIdentities.ready?()
+  end
+
+  test "keyed-provider raw is valid legacy evidence without an OSM source" do
+    a = historical(-42)
+
+    {:ok, a} =
+      Locations.update_address(a, %{
+        raw: %{"upstream" => %{"provider" => "amap"}, "lat" => "48.8584", "lon" => "2.2945"}
+      })
+
+    path = export_file([identity(-42)], 100)
+    assert {:ok, %{mode: :applied}} = LocalIdentities.import_file(path, apply: true)
+    assert Repo.get!(Address, a.id).raw["georelay"]["outside_mainland"] == false
+  end
+
+  test "exact storage retains more than Decimal's default 34 significant digits" do
+    initialize()
+    lat = "1.123456789012345678901234567890123456789"
+
+    with_mock Tesla.Adapter.Finch,
+      call: fn env, _ ->
+        {:ok, %{env | status: 200, body: response(Jason.decode!(env.body)["address"])}}
+      end do
+      assert {:ok, address} = Locations.find_address(%{latitude: lat, longitude: "2"})
+      assert Decimal.to_string(address.latitude, :normal) == lat
+    end
+  end
+
+  test "long exact-coordinate lookup stays under HTTP byte limit and fails as a whole" do
+    initialize()
+
+    addresses =
+      for index <- 1..50 do
+        value = "0." <> String.duplicate("0", 990) <> Integer.to_string(index)
+        decimal = Decimal.new(value, max_digits: 1024, max_exponent: 1024)
+
+        %Address{
+          osm_id: -index,
+          osm_type: "node",
+          latitude: decimal,
+          longitude: decimal,
+          raw: %{}
+        }
+      end
+
+    for fail_second? <- [false, true] do
+      Process.put(:georelay_test_calls, 0)
+
+      with_mock Tesla.Adapter.Finch,
+        call: fn env, _ ->
+          call = Process.get(:georelay_test_calls) + 1
+          Process.put(:georelay_test_calls, call)
+          assert byte_size(env.body) <= 60 * 1024
+          body = Jason.decode!(env.body)
+
+          if fail_second? and call == 2 do
+            {:ok, %{env | status: 502, body: "private failure"}}
+          else
+            raws = Enum.map(body["addresses"], &response/1)
+            {:ok, %{env | status: 200, body: Jason.encode!(raws)}}
+          end
+        end do
+        if fail_second? do
+          assert {:error, :geocoder_unavailable} = Geocoder.details(addresses, "en")
+        else
+          assert {:ok, details} = Geocoder.details(addresses, "en")
+          assert length(details) == 50
+          assert Enum.map(details, & &1.osm_id) == Enum.map(addresses, & &1.osm_id)
+        end
+
+        assert Process.get(:georelay_test_calls) == 2
+      end
+    end
+
+    assert Repo.aggregate(Address, :count) == 0
+  end
+
+  defp initialize do
+    assert {:ok, %{mode: :applied}} =
+             LocalIdentities.initialize_fresh(apply: true, fresh_install: true)
+  end
+
+  defp point, do: %{latitude: Decimal.new("48.858400123"), longitude: Decimal.new("2.294500456")}
+
+  defp source_context,
+    do: %{"source_osm_type" => "way", "source_osm_id" => 42, "outside_mainland" => true}
+
+  defp response(request) do
+    %{
+      "osm_id" => request["osm_id"],
+      "osm_type" => "node",
+      "lat" => request["lat"],
+      "lon" => request["lon"],
+      "display_name" => "Synthetic address",
+      "address" => %{"city" => "Synthetic city"},
+      "georelay" => Map.put(request["context"], "version", 1)
+    }
+  end
+
+  defp identity(id, lat \\ "48.8584", lon \\ "2.2945", context \\ %{"outside_mainland" => false}) do
+    %{"osm_id" => id, "osm_type" => "node", "lat" => lat, "lon" => lon, "context" => context}
+  end
+
+  defp historical(id, type \\ "node", lat \\ "48.8584", lon \\ "2.2945") do
+    {:ok, address} =
+      Locations.create_address(%{
+        osm_id: id,
+        osm_type: type,
+        latitude: lat,
+        longitude: lon,
+        display_name: "Historical",
+        raw: %{}
+      })
+
+    address
+  end
+
+  defp export_file(rows, high_water) do
+    path =
+      Path.join(System.tmp_dir!(), "georelay-legacy-#{System.unique_integer([:positive])}.json")
+
+    File.write!(
+      path,
+      Jason.encode!(%{
+        "format" => "georelay-legacy-identities-v1",
+        "allocated_high_water" => high_water,
+        "identities" => rows
+      })
+    )
+
+    File.chmod!(path, 0o600)
+    on_exit(fn -> File.rm(path) end)
+    path
+  end
+end
