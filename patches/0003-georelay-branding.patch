diff --git a/elixir/test/teslamate_web/controllers/branding_controller_test.exs b/elixir/test/teslamate_web/controllers/branding_controller_test.exs
new file mode 100644
index 0000000..2a4e117
--- /dev/null
+++ b/elixir/test/teslamate_web/controllers/branding_controller_test.exs
@@ -0,0 +1,48 @@
+defmodule TeslaMateWeb.BrandingControllerTest do
+  use TeslaMateWeb.ConnCase
+  import Mock
+
+  @disclaimer "This project is an unofficial community tool and is not affiliated with, endorsed by, or supported by the official TeslaMate project."
+
+  test "renders independent branding, source and legal credit in every locale", %{conn: conn} do
+    with_mock TeslaMate.Vault, [:passthrough], encryption_key_provided?: fn -> false end do
+      for locale <- ["en", "de", "zh_Hans"] do
+        html = conn |> get("/settings?locale=#{locale}") |> html_response(200)
+        document = Floki.parse_document!(html)
+
+        assert document |> Floki.find("title") |> Floki.text() =~ " · GeoRelay"
+
+        assert document |> Floki.find(".navbar-brand > a") |> Floki.text() |> String.trim() ==
+                 "GeoRelay"
+
+        assert document |> Floki.find("footer") |> Floki.text() =~ @disclaimer
+
+        assert Floki.attribute(document, "footer a", "href")
+               |> Enum.member?("https://github.com/srcheng17/georelay")
+
+        # REUSE-IgnoreStart
+        assert document |> Floki.find("footer .legal") |> Floki.text() =~
+                 "© the TeslaMate contributors"
+
+        # REUSE-IgnoreEnd
+        assert document |> Floki.find("footer .legal") |> Floki.text() =~ "AGPL-3.0-or-later"
+        assert document |> Floki.find(".notification.is-warning") |> Floki.text() =~ "GeoRelay"
+
+        assert Floki.attribute(document, "table.about a", "href")
+               |> Enum.member?("https://github.com/srcheng17/georelay")
+
+        refute html =~ "/images/logo.svg"
+        assert [favicon] = Floki.attribute(document, "link[rel=icon]", "href")
+        assert favicon =~ "/favicon.svg"
+      end
+    end
+  end
+
+  test "serves the neutral favicon without upstream icons", %{conn: conn} do
+    conn = get(conn, "/favicon.svg")
+    assert response(conn, 200) =~ "<svg"
+    assert get_resp_header(conn, "content-type") == ["image/svg+xml"]
+    refute File.exists?(Application.app_dir(:teslamate, "priv/static/favicon.ico"))
+    refute File.exists?(Application.app_dir(:teslamate, "priv/static/images/logo.svg"))
+  end
+end
