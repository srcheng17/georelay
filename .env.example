# Copy to .env; never commit real credentials or print rendered runtime config.
# Use latest, or choose the same published version for both GHCR images.
GEORELAY_VERSION=latest
GEOCODER_PROVIDER=auto
MAINLAND_PROVIDER=amap
AMAP_API_REGION=mainland
AMAP_KEY=
BAIDU_AK=
BAIDU_SK=
# Example format: GeoRelay/0.1 (contact: your-real-address@example.org)
NOMINATIM_USER_AGENT=
