# Copy to .env; never commit real credentials or print rendered runtime config.
# Use latest, or the same published version for georelay and georelay-adapter.
GEORELAY_VERSION=latest
# Compose enables GEORELAY_ADDRESS_MODE=application in the patched application.
# Explicit fresh initialization or legacy import is required before address lookup.
GEOCODER_PROVIDER=auto
MAINLAND_PROVIDER=amap
AMAP_API_REGION=mainland
AMAP_KEY=
BAIDU_AK=
BAIDU_SK=
# Example format: GeoRelay/0.1 (contact: your-real-address@example.org)
NOMINATIM_USER_AGENT=
